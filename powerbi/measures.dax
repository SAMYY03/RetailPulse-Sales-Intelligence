// Item prices excluding freight, across all order statuses in the current sales-item selection.
Revenue = SUM(FactSales[Price])

// Freight charged on selected sales items; this is not freight profit.
Freight Revenue = SUM(FactSales[FreightValue])

// Item prices plus freight for selected sales items; not a payment reconciliation measure.
Total Order Value = [Revenue] + [Freight Revenue]

// Distinct orders with sales items in the current selection. Orders without items are excluded.
Orders = DISTINCTCOUNT(FactSales[OrderID])

// Sales-item rows in the current selection, including all order statuses.
Units Sold = COUNTROWS(FactSales)

// Distinct people with selected sales items, using the persistent customer_unique_id. Respects date, product, customer and order filters.
Customers = COUNTROWS(FILTER(SUMMARIZE(FactSales, DimCustomer[customer_unique_id]), NOT ISBLANK(DimCustomer[customer_unique_id])))

// Average selected merchandise value per order, excluding freight. Returns zero when there are no orders.
AOV = COALESCE(DIVIDE([Revenue], [Orders]), 0)

// Average selected item value plus freight per order. Returns zero when there are no orders.
AOV Including Freight = COALESCE(DIVIDE([Total Order Value], [Orders]), 0)

// Average selected sales-item count per order. Returns zero when there are no orders.
Units per Order = COALESCE(DIVIDE([Units Sold], [Orders]), 0)

// Selected merchandise revenue per distinct person, excluding freight.
Revenue per Customer = COALESCE(DIVIDE([Revenue], [Customers]), 0)

// People with more than one distinct order within the current selection, not lifetime repeat buyers.
Repeat Customers = COUNTROWS(FILTER(ADDCOLUMNS(FILTER(SUMMARIZE(FactSales, DimCustomer[customer_unique_id]), NOT ISBLANK(DimCustomer[customer_unique_id])), "@OrderCount", CALCULATE([Orders])), [@OrderCount] > 1))

// Share of customers with more than one selected order. Returns zero for an empty selection.
Repeat Customer Rate = COALESCE(DIVIDE([Repeat Customers], [Customers]), 0)

// Revenue over the selected calendar dates shifted back one year. Blank for selections spanning multiple years or absent prior data. Use DimDate for date slicing.
Revenue PY = IF(HASONEVALUE(DimDate[Year]), CALCULATE([Revenue], DATEADD(DimDate[Date], -1, YEAR)))

// Selected revenue minus prior-year comparable-date revenue; blank without a comparison.
YoY Revenue Change = IF(NOT ISBLANK([Revenue]) && NOT ISBLANK([Revenue PY]), [Revenue] - [Revenue PY])

// Revenue change divided by prior-year revenue; blank for missing or zero baselines. Incomplete periods must be disclosed.
YoY Revenue Growth % = DIVIDE([YoY Revenue Change], [Revenue PY])

// Distinct delivered orders with selected sales items, counted once per order.
Delivered Orders = CALCULATE(COUNTROWS(Orders), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"))

// Delivered orders with both actual and estimated delivery dates, used as the late-rate denominator.
Delivery Eligible Orders = CALCULATE(COUNTROWS(Orders), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"), FILTER(Orders, NOT ISBLANK(Orders[order_delivered_customer_date]) && NOT ISBLANK(Orders[order_estimated_delivery_date])))

// Eligible orders arriving after the estimated calendar date. Same-day arrival is on time.
Late Orders = CALCULATE(COUNTROWS(Orders), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"), FILTER(Orders, NOT ISBLANK(Orders[order_delivered_customer_date]) && NOT ISBLANK(Orders[order_estimated_delivery_date]) && INT(Orders[order_delivered_customer_date]) > INT(Orders[order_estimated_delivery_date])))

// Late orders / eligible delivered orders; blank when no eligible deliveries exist.
Late Delivery Rate = IF([Delivery Eligible Orders] > 0, DIVIDE(COALESCE([Late Orders], 0), [Delivery Eligible Orders]))

// Mean calendar days from purchase to actual delivery, one observation per delivered order. Missing or negative durations excluded.
Average Delivery Days = CALCULATE(AVERAGEX(FILTER(Orders, NOT ISBLANK(Orders[order_purchase_timestamp]) && NOT ISBLANK(Orders[order_delivered_customer_date]) && Orders[order_delivered_customer_date] >= Orders[order_purchase_timestamp]), DATEDIFF(Orders[order_purchase_timestamp], Orders[order_delivered_customer_date], DAY)), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"))

// Selected orders with at least one valid 1–5 review score.
Reviewed Orders = CALCULATE(DISTINCTCOUNT(olist_order_reviews_dataset[order_id]), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), olist_order_reviews_dataset[order_id])), KEEPFILTERS(olist_order_reviews_dataset[review_score] >= 1), KEEPFILTERS(olist_order_reviews_dataset[review_score] <= 5))

// Mean of each selected order’s mean valid review score. Equal weight per order prevents multiple responses or sales items overweighting an order.
Average Review Score = CALCULATE(AVERAGEX(VALUES(olist_order_reviews_dataset[order_id]), CALCULATE(AVERAGE(olist_order_reviews_dataset[review_score]))), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), olist_order_reviews_dataset[order_id])), KEEPFILTERS(olist_order_reviews_dataset[review_score] >= 1), KEEPFILTERS(olist_order_reviews_dataset[review_score] <= 5))

