table 'measures (2)'
	lineageTag: ef1fa0f0-1f08-48aa-bff1-13c08f4fa9fb

	/// Item prices excluding freight, across all order statuses in the current sales-item selection.
	measure Revenue = SUM(FactSales[Price])
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		lineageTag: eb5a3b50-917f-4417-8a26-4333a6b8ac6a

	/// Freight charged on selected sales items; this is not freight profit.
	measure 'Freight Revenue' = SUM(FactSales[FreightValue])
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		lineageTag: 84ab9884-c651-44a7-92fe-5a072bae86c8

	/// Item prices plus freight for selected sales items; not a payment reconciliation measure.
	measure 'Total Order Value' = [Revenue] + [Freight Revenue]
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		lineageTag: 89cc3b27-c5a4-4f96-bb96-df9a6d7a58c1

	/// Distinct orders with sales items in the current selection. Orders without items are excluded.
	measure Orders = DISTINCTCOUNT(FactSales[OrderID])
		formatString: #,0
		lineageTag: 38334abb-a299-4ca5-baa0-f1ec8a3c0cfc

	/// Sales-item rows in the current selection, including all order statuses.
	measure 'Units Sold' = COUNTROWS(FactSales)
		formatString: #,0
		lineageTag: 53463fdb-080d-45c6-b0db-1da080eb63f8

	/// Distinct people with selected sales items, using the persistent customer_unique_id. Respects date, product, customer and order filters.
	measure Customers = COUNTROWS(FILTER(SUMMARIZE(FactSales, DimCustomer[customer_unique_id]), NOT ISBLANK(DimCustomer[customer_unique_id])))
		formatString: #,0
		lineageTag: 255582b1-895e-4b85-8524-5a2a99cef937

	/// Average selected merchandise value per order, excluding freight. Returns zero when there are no orders.
	measure AOV = COALESCE(DIVIDE([Revenue], [Orders]), 0)
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		lineageTag: e04055ff-58a3-4223-ae76-8b8b4cfba013

	/// Average selected item value plus freight per order. Returns zero when there are no orders.
	measure 'AOV Including Freight' = COALESCE(DIVIDE([Total Order Value], [Orders]), 0)
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		lineageTag: 2647e57e-2aee-4c21-9201-e8c306f10251

	/// Average selected sales-item count per order. Returns zero when there are no orders.
	measure 'Units per Order' = COALESCE(DIVIDE([Units Sold], [Orders]), 0)
		formatString: 0.00
		lineageTag: 5fd72853-e76d-4736-98ac-fdf222c09a18

	/// Selected merchandise revenue per distinct person, excluding freight.
	measure 'Revenue per Customer' = COALESCE(DIVIDE([Revenue], [Customers]), 0)
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		lineageTag: 8f21d13a-dce0-4594-ae55-07caece23350

	/// People with more than one distinct order within the current selection, not lifetime repeat buyers.
	measure 'Repeat Customers' = COUNTROWS(FILTER(ADDCOLUMNS(FILTER(SUMMARIZE(FactSales, DimCustomer[customer_unique_id]), NOT ISBLANK(DimCustomer[customer_unique_id])), "@OrderCount", CALCULATE([Orders])), [@OrderCount] > 1))
		formatString: #,0
		lineageTag: 8e139f43-123a-4fe8-94bc-8d913e4999c6

	/// Share of customers with more than one selected order. Returns zero for an empty selection.
	measure 'Repeat Customer Rate' = COALESCE(DIVIDE([Repeat Customers], [Customers]), 0)
		formatString: 0.0%
		lineageTag: 45cd5891-93c8-431f-9daf-ebb3d61fabce

	/// Revenue over the selected calendar dates shifted back one year. Blank for selections spanning multiple years or absent prior data. Use DimDate for date slicing.
	measure 'Revenue PY' = IF(HASONEVALUE(DimDate[Year]), CALCULATE([Revenue], DATEADD(DimDate[Date], -1, YEAR)))
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		displayFolder: Growth
		lineageTag: 52bed3ec-d434-41b6-8f06-ec10a94fddab

	/// Selected revenue minus prior-year comparable-date revenue; blank without a comparison.
	measure 'YoY Revenue Change' = IF(NOT ISBLANK([Revenue]) && NOT ISBLANK([Revenue PY]), [Revenue] - [Revenue PY])
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		displayFolder: Growth
		lineageTag: 822a600c-bd1f-4661-9e7d-a40d4d5f17eb

	/// Revenue change divided by prior-year revenue; blank for missing or zero baselines. Incomplete periods must be disclosed.
	measure 'YoY Revenue Growth %' = DIVIDE([YoY Revenue Change], [Revenue PY])
		formatString: 0.0%
		displayFolder: Growth
		lineageTag: 814f7fd7-9c76-4baa-9188-055579596576

	/// Distinct delivered orders with selected sales items, counted once per order.
	measure 'Delivered Orders' = CALCULATE(COUNTROWS(Orders), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"))
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 3f023fe9-5b6a-4194-942c-81c308a1c3ba

	/// Delivered orders with both actual and estimated delivery dates, used as the late-rate denominator.
	measure 'Delivery Eligible Orders' = CALCULATE(COUNTROWS(Orders), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"), FILTER(Orders, NOT ISBLANK(Orders[order_delivered_customer_date]) && NOT ISBLANK(Orders[order_estimated_delivery_date])))
		formatString: #,0
		displayFolder: Delivery
		lineageTag: f901726f-4154-40c4-b8a4-9a5aee1f5b34

	/// Eligible orders arriving after the estimated calendar date. Same-day arrival is on time.
	measure 'Late Orders' = CALCULATE(COUNTROWS(Orders), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"), FILTER(Orders, NOT ISBLANK(Orders[order_delivered_customer_date]) && NOT ISBLANK(Orders[order_estimated_delivery_date]) && INT(Orders[order_delivered_customer_date]) > INT(Orders[order_estimated_delivery_date])))
		formatString: #,0
		displayFolder: Delivery
		lineageTag: de3af06a-0c5c-4e5e-9143-8f2365cf5d32

	/// Late orders / eligible delivered orders; blank when no eligible deliveries exist.
	measure 'Late Delivery Rate' = IF([Delivery Eligible Orders] > 0, DIVIDE(COALESCE([Late Orders], 0), [Delivery Eligible Orders]))
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: ac650a4a-5ec2-4468-b182-79eb6908ccbc

	/// Mean calendar days from purchase to actual delivery, one observation per delivered order. Missing or negative durations excluded.
	measure 'Average Delivery Days' = CALCULATE(AVERAGEX(FILTER(Orders, NOT ISBLANK(Orders[order_purchase_timestamp]) && NOT ISBLANK(Orders[order_delivered_customer_date]) && Orders[order_delivered_customer_date] >= Orders[order_purchase_timestamp]), DATEDIFF(Orders[order_purchase_timestamp], Orders[order_delivered_customer_date], DAY)), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), Orders[order_id])), KEEPFILTERS(Orders[order_status] = "delivered"))
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 8331159a-b183-4f64-83da-e1dd5a72f93d

	/// Selected orders with at least one valid 1–5 review score.
	measure 'Reviewed Orders' = CALCULATE(DISTINCTCOUNT(olist_order_reviews_dataset[order_id]), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), olist_order_reviews_dataset[order_id])), KEEPFILTERS(olist_order_reviews_dataset[review_score] >= 1), KEEPFILTERS(olist_order_reviews_dataset[review_score] <= 5))
		formatString: #,0
		displayFolder: Customer Experience
		lineageTag: 0aceb67a-f084-4652-8e26-f4013d24a629

	/// Mean of each selected order’s mean valid review score. Equal weight per order prevents multiple responses or sales items overweighting an order.
	measure 'Average Review Score' = CALCULATE(AVERAGEX(VALUES(olist_order_reviews_dataset[order_id]), CALCULATE(AVERAGE(olist_order_reviews_dataset[review_score]))), KEEPFILTERS(TREATAS(VALUES(FactSales[OrderID]), olist_order_reviews_dataset[order_id])), KEEPFILTERS(olist_order_reviews_dataset[review_score] >= 1), KEEPFILTERS(olist_order_reviews_dataset[review_score] <= 5))
		formatString: 0.00
		displayFolder: Customer Experience
		lineageTag: bd992ad1-9dc3-4bee-aeec-fed68143cee8

	column Column1
		dataType: string
		lineageTag: 1a7e40dd-35a2-4d5f-aae1-9a17b650a8d4
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition 'measures (2)' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

